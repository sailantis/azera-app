{
    "name": "sailantis/azera-app",
    "type": "project",
    "description": "A starter project for the Azera PHP framework",
    "license": "MIT",
    "require": {
        "php": ">=8.2",
        "sailantis/azera-framework": "^0.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "serve": "php vendor/bin/azera serve",
        "db": "php vendor/bin/azera db",
        "routes": "php vendor/bin/azera routes"
    },
    "config": {
        "allow-plugins": {
            "sailantis/azera-framework": true
        }
    }
}
