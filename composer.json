{
    "name": "sailantis/azera-app",
    "type": "project",
    "description": "A starter project for the Azera PHP framework",
    "license": "MIT",
    "require": {
        "php": ">=8.2",
        "sailantis/azera-framework": "^0.4"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "serve": "php vendor/bin/azera serve",
        "routes": "php vendor/bin/azera routes:list",
        "db": "php vendor/bin/azera db:tables",
        "test": "@php vendor/bin/phpunit",
        "post-create-project-cmd": [
            "@php -r \"echo PHP_EOL . 'Azera App is ready. Start the dev server with: composer serve' . PHP_EOL;\""
        ]
    },
    "extra": {
        "azera": {
            "provider": "App\\Bootstrap"
        }
    },
    "config": {
        "allow-plugins": {
            "sailantis/azera-framework": true
        }
    }
}
